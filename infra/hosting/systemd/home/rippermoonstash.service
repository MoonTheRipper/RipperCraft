[Unit]
Description=RipperMoonStash admin dashboard
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/ripper-moon/minecraft-server
Environment=HOST=127.0.0.1
Environment=PORT=4300
ExecStart=/home/ripper-moon/.nvm/versions/node/v24.15.0/bin/npm start
Restart=always
RestartSec=5
User=ripper-moon
Group=ripper-moon

[Install]
WantedBy=multi-user.target
