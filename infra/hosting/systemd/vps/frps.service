[Unit]
Description=frp server for RipperMoonStash
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/rippermoonstash/hosting.env
ExecStart=/usr/local/bin/frps -c /etc/frp/frps.toml
Restart=always
RestartSec=5
User=frp
Group=frp
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
